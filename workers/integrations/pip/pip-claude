#!/usr/bin/env bash
set -euo pipefail
if [[ -z "${PIP_API_KEY:-}" ]]; then
  task_key_file="${XDG_CONFIG_HOME:-$HOME/.config}/jkt48connect-ai/gateway.env"
  if [[ ! -f "$task_key_file" ]]; then
    echo 'Set PIP_API_KEY or prepare the private jkt48connect-ai/gateway.env file.' >&2
    exit 1
  fi
  set -a
  source "$task_key_file"
  set +a
fi
export ANTHROPIC_BASE_URL="https://api.jkt48connect.app"
export ANTHROPIC_AUTH_TOKEN="$PIP_API_KEY"
export ANTHROPIC_MODEL="pip-code"
export ANTHROPIC_DEFAULT_OPUS_MODEL="pip-code"
export ANTHROPIC_DEFAULT_SONNET_MODEL="pip-code"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="pip"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=120000
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
exec claude --model pip-code "$@"
