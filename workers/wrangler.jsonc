{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jkt48showroom-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "build": { "command": "node scripts/prepare-env.js" },
  "secrets": { "required": ["SECRET", "AUTH_SECRET", "JWT_SECRET", "API_KEY"] },
  "vars": {
    "NODE_ENV": "production",
    "SHOWROOM_API": "https://www.showroom-live.com",
    "MAX_QUERY_DOCUMENTS": "10000",
    "UPSTREAM_TIMEOUT_MS": "15000",
    "LIVE_REFRESH_SECONDS": "300",
    "ORIGINS": "http://localhost:3000",
    "DEFAULT_ORIGIN": "http://localhost:3000",
    "ADMIN_IDS": "",
    "SECONDARY_ORIGINS": "",
    "PROXY_URL": "",
    "STREAM_ALLOWED_HOSTS": "playback.live-video.net,live.showroom-live.com",
    "CLOUDINARY_CLOUD_NAME": "",
    "IMAGE_PUBLIC_URL": "",
    "JKT48_AUTO_SYNC": "true",
    "JKT48_API_BASE": "https://jkt48.com/api/v1/",
    "JKT48_SYNC_SECONDS": "3600",
    "JKT48_NEWS_PAGES": "3",
    "JKT48_SCHEDULE_MONTHS": "3",
    "JKT48_DETAIL_LIMIT": "20"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "jkt48showroom-api-db", "database_id": "d82f76e4-2bf9-4585-8a1f-c7d7dc870bac", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES_BUCKET", "bucket_name": "jkt48showroom-api-images-bucket" }],
  "durable_objects": { "bindings": [{ "name": "LIVE_HUB", "class_name": "LiveHub" }, { "name": "COORDINATOR", "class_name": "Coordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub", "Coordinator"] }],
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *"] },
  "alias": { "mongoose": "./src/runtime/database.js", "cli-progress": "./src/runtime/progress.js" }
}
