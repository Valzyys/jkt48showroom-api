{
  "name": "jkt48showroom-api-workers",
  "version": "0.14.2-workers.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/deploy.js --dry-run --outdir dist",
    "deploy": "node scripts/deploy.js",
    "setup:env": "node scripts/prepare-env.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "import:mongo": "node scripts/import-mongo.js"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "3.0.4",
    "cbor-x": "1.6.0",
    "dayjs": "1.11.12",
    "defu": "6.1.7",
    "fuse.js": "7.0.0",
    "hono": "4.13.13",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.18.1",
    "mingo": "6.6.1",
    "mongoose-legacy-pluralize": "2.0.0",
    "node-html-parser": "6.1.13",
    "ofetch": "1.4.1",
    "string-comparison": "1.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": { "wrangler": "4.149.0", "miniflare": "^4.0.0", "esbuild": "^0.25.0" }
}
