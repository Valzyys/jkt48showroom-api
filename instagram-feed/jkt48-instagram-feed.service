[Unit]
Description=JKT48 anonymous Instagram archive collector
After=network-online.target
Wants=network-online.target

[Service]
User=jkt48instagram
Group=jkt48instagram
WorkingDirectory=/var/lib/jkt48-instagram-feed
EnvironmentFile=/etc/jkt48-instagram-feed.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/jkt48-instagram-feed
ExecStart=/opt/jkt48-instagram-feed/.venv/bin/python /opt/jkt48-instagram-feed/service.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jkt48-instagram-feed
MemoryMax=320M
CPUQuota=20%
TasksMax=160
UMask=0077

[Install]
WantedBy=multi-user.target
