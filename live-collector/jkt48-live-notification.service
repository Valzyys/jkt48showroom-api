[Unit]
Description=Render live notification cards and upload directly to R2
After=network-online.target
[Service]
Type=oneshot
User=jkt48collector
Group=jkt48collector
RuntimeDirectory=jkt48-live-notification
Environment=XDG_CONFIG_HOME=/run/jkt48-live-notification
Environment=XDG_CACHE_HOME=/run/jkt48-live-notification
WorkingDirectory=/opt/jkt48-live-collector
EnvironmentFile=/etc/jkt48-live-collector.env
EnvironmentFile=-/etc/jkt48-live-notification.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=COLLECTOR_CHROME_PATH=/opt/jkt48-live-collector/chrome/chrome
Environment=COLLECTOR_MEDIA_TRANSPORT_URL=https://jkt48showroom-api.aslannarnia806.workers.dev
ExecStart=/usr/bin/node /opt/jkt48-live-collector/live-notification-renderer.cjs
TimeoutStartSec=4min
CPUQuota=50%
MemoryMax=600M
TasksMax=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
